    "content:build": "tsx scripts/build-content.ts",
    "validate": "tsx scripts/validate.ts",
    "coverage": "tsx scripts/coverage.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
